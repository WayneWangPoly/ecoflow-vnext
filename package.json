{
  "name": "ecoflow-vnext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "import:master-data": "node scripts/import-master-data.mjs",
    "audit:ordermentum": "node scripts/audit-ordermentum-operational-readiness.mjs",
    "audit:release-gate": "node scripts/audit-ordermentum-release-gate.mjs",
    "audit:import-control": "node scripts/audit-ordermentum-import-control.mjs",
    "audit:warehouse": "node scripts/audit-warehouse-productisation.mjs && node scripts/audit-stocktake-field-journal.mjs",
    "audit:operational-safety": "node scripts/audit-operational-safety-continuity.mjs",
    "audit:release-receiving": "node scripts/audit-release-receiving-clarity.mjs",
    "test:warehouse": "node scripts/audit-warehouse-productisation.mjs && node scripts/audit-stocktake-field-journal.mjs",
    "import:ordermentum:backfill": "node scripts/import-ordermentum-backfill-all.mjs",
    "import:ordermentum:incremental": "node scripts/import-ordermentum-incremental.mjs",
    "import:ordermentum:missing-invoices": "node scripts/refresh-ordermentum-missing-invoices.mjs",
    "test:ordermentum-auth": "node scripts/test-ordermentum-auth-and-orders.mjs",
    "auth:set-password": "node scripts/admin-set-user-password.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@vitejs/plugin-react": "6.0.2",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.15.1",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": "22.x"
  }
}
