{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Builder OS Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective",
    "in_scope",
    "out_of_scope",
    "authority",
    "behavior_contract",
    "acceptance",
    "rollback",
    "required_evidence",
    "owner_role",
    "verification_role"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "in_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "behavior_contract": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "owner_role": {
      "type": "string"
    },
    "verification_role": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
